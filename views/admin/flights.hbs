<!--ADMIN FLIGHT MANAGEMENT PAGE -->


<!-- Search and add flight button -->
<div class="container mt-4">
  <div class="table-card mb-3">

    <div class="row g-1 align-items-center">

      <div class="col-md-5">

        <div class="input-group">
          <span class="input-group-text bg-white border-end-0">
            <i class="bi bi-search text-muted"></i>
          </span>
          <input type="text" class="form-control border-start-0" id="flightSearch" placeholder="Search flights">
        </div>

      </div>

      <div class="col-md-7 d-flex justify-content-end">
        <button type="button" class="btn primary-btn" id="searchBtn" onclick="addFlight.showModal()">
          <i class="bi bi-plus-lg"></i> Add Flight
        </button>
      </div>

    </div>

  </div>
</div>


<!-- Flights table -->
<div class="container">
  <div class="table-card">
    <table class="table table mb-0">
      <thead>
        <tr>
          <th>Flight</th>
          <th>Airline</th>
          <th>Route</th>
          <th>Departure</th>
          <th>Arrival</th>
          <th>Price</th>
          <th>Promo</th>
          <th>Seats</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>

      </thead>
      <tbody id="TableBody">
        {{#if flights.length}}
        {{#each flights}}
        <tr id="flight-row-{{this._id}}" data-id="{{this._id}}" data-flightcode="{{this.flightCode}}"
          data-triptype="{{this.tripType}}" data-status="{{this.status}}" data-airline="{{this.airline}}"
          data-origin="{{this.origin}}" data-destination="{{this.destination}}"
          data-departure="{{this.departureDateISO}}" data-arrival="{{this.arrivalDateISO}}" data-price="{{this.price}}"
          data-seats="{{this.availableSeats}}" data-ispromo="{{this.isPromo}}"
          data-discountpercent="{{this.discountPercent}}" data-promotitle="{{this.promoLabel}}"
          data-promostartdate="{{this.promoStartDateISO}}" data-promoenddate="{{this.promoEndDateISO}}">
          <td class="col-flightCode fw-bold">{{this.flightCode}}</td>
          <td class="col-airline">{{this.airline}}</td>
          <td class="col-route">{{this.origin}} <i class="bi bi-arrow-right"></i> {{this.destination}}</td>
          <td class="col-departure">{{this.departureFormatted}}</td>
          <td class="col-arrival">{{this.arrivalFormatted}}</td>
          <td class="col-price">₱{{this.priceFormatted}}</td>
          <td class="col-promo">
            {{#if this.isPromo}}
            <button class="btn btn-sm secondary-btn" onclick="openPromoModal('{{this._id}}')">
              View
            </button>
            {{else}}
            <span class="text-muted">—</span>
            {{/if}}
          </td>
          <td class="col-seats">{{this.availableSeats}}</td>
          <td class="col-status">
            <span class="badge badge-{{this.statusBadgeClass}}">{{this.statusCapitalized}}</span>
          </td>
          <td>
            <div>
              <button class="edit-btn" onclick="openEditFlightModal('{{this._id}}')">
                <i class="bi bi-pencil me-1"></i>
              </button>
              <button class="delete-btn" onclick="openDeleteFlightModal('{{this._id}}', '{{this.flightCode}}')">
                <i class="bi bi-trash3 ms-1"></i>
              </button>
            </div>
          </td>
        </tr>
        {{/each}}
        {{else}}
        <tr id="noFlightsRow">
          <td colspan="10" class="text-center text-muted py-4">No flights found in database. Click 'Add Flight' above to
            create one.</td>
        </tr>
        {{/if}}
      </tbody>
    </table>


    <!-- Pagination -->
    <div class="d-flex justify-content-between align-items-center mt-3 px-2" id="Pagination">
      <button class="btn btn-outline-secondary btn-sm" id="resPrevBtn">
        <i class="bi bi-chevron-left me-1"></i>Back
      </button>
      <span class="res-page-info" id="resPageInfo"></span>
      <button class="btn btn-save btn-sm" id="resNextBtn">
        Next<i class="bi bi-chevron-right ms-1"></i>
      </button>
    </div>
  </div>

</div>

<!-- Promotion Details Modal -->
<dialog id="promoDetailsDialog" class="w-25">
  <div class="card">
    <div class="card-header">
      Promotion Details
    </div>

    <div class="card-body">

      <div class="mb-3">
        <label class="fw-semibold">Promotion Detail</label>
        <p id="promoLabelText" class="mb-0"></p>
      </div>

      <div class="mb-3">
        <label class="fw-semibold">Discount</label>
        <p id="promoDiscountText" class="mb-0"></p>
      </div>

      <div class="mb-3">
        <label class="fw-semibold">Promotion Starts</label>
        <p id="promoStartText" class="mb-0"></p>
      </div>

      <div class="mb-3">
        <label class="fw-semibold">Promotion Ends</label>
        <p id="promoEndText" class="mb-0"></p>
      </div>

    </div>

    <div class="card-footer text-end">
      <button class="btn secondary-btn" onclick="document.getElementById('promoDetailsDialog').close()">
        Close
      </button>
    </div>
  </div>
</dialog>


<!--Add flight modal-->
<dialog class="w-50" id="addFlight">
  <div class="card">
    <div class="card-header">
      Add Flight
    </div>
    <div class="card-body">
      <div id="addFlightError" class="alert alert-danger d-none mb-3"></div>

      <div class="row g-3 mb-3 align-items-start">

        <!--Trip Type -->
        <div class="col-md-12">

          <label class="form-label">Trip Type</label>

          <div class="d-flex gap-3">

            <div class="form-check">
              <input class="form-check-input" type="radio" name="tripType" id="oneWay" value="oneway" checked>
              <label class="form-check-label" for="oneWay">One-way</label>
            </div>

            <div class="form-check">
              <input class="form-check-input" type="radio" name="tripType" id="roundTrip" value="round">
              <label class="form-check-label" for="roundTrip">Round-trip</label>
            </div>

          </div>

        </div>
      </div>


      <!-- Flight number and flight status-->
      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="form-label" for="flightNum">Flight Number</label>
          <input type="text" class="form-control" id="flightNum" name="flightNum" placeholder="e.g. PR-101">
        </div>
        <div class="col-md-6">
          <label class="form-label" for="flightStatus">Status</label>
          <select class="form-select status-select" id="flightStatus" name="flightStatus">
            <option value="scheduled" selected>Scheduled</option>
            <option value="delayed">Delayed</option>
            <option value="cancelled">Cancelled</option>
          </select>
        </div>
      </div>

      <!--Airline-->
      <div class="row g-3 mb-3">

        <div class="col-md-12">
          <label class="form-label" for="airline">Airline</label>
          <select class="form-select status-select" id="airline" name="airline">
            <option value="">Select Airline</option>
            {{#each airlines}}
            <option value="{{this}}">{{this}}</option>
            {{/each}}
          </select>
        </div>
      </div>

      <!-- Origin and Destination-->
      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="form-label" for="fromField">Origin</label>

          <select class="form-select" id="fromField">
            <option value="">Select Origin</option>
            {{#each airports}}
            <option value="{{this}}">{{this}}</option>
            {{/each}}
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="toField">Destination</label>

          <select class="form-select" id="toField">
            <option value="">Select Destination</option>
            {{#each airports}}
            <option value="{{this}}">{{this}}</option>
            {{/each}}
          </select>
        </div>
      </div>

      <!-- Departure and Arrival-->
      <div class="row g-3 mb-3">
        <div class="col-md-6">

          <label class="form-label">Depart Date & Time</label>
          <input type="datetime-local" class="form-control" id="departDate">

        </div>
        <div class="col-md-6">
          <label class="form-label">Arrival Date & Time</label>
          <input type="datetime-local" class="form-control" id="arrivalDate">
        </div>
      </div>

      <!--Price-->
      <div class="row g-3 mb-3">

        <div class="col-md-12">
          <label class="form-label" for="price">Ticket Price (₱)</label>
          <input type="number" min="0" class="form-control" id="price" name="price" placeholder="e.g. 5000">
        </div>
      </div>

      <!--Seats-->
      <div class="row g-3 mb-3">

        <div class="col-md-12">
          <label class="form-label" for="seats">Available Seats</label>
          <input type="number" min="0" class="form-control" id="seats" name="seats" placeholder="e.g. 150">
        </div>
      </div>


      <!-- Promotion -->
      <div class="row g-3 mb-3">

        <div class="col-md-12">

          <div class="form-check">

            <input class="form-check-input" type="checkbox" id="isPromo" name="isPromo">
            <label class="form-check-label fw-semibold" for="isPromo">
              Feature this flight as a promotional offer
            </label>

          </div>

        </div>

      </div>

      <!-- Promotion Details -->
      <div id="promoFields" style="display:none;">

        <div class="mb-3">
          <label class="form-label">Discount Value (%)</label>
          <input type="number" class="form-control" id="discountPercent" name="discountPercent" min="0"
            placeholder="e.g. 20">
        </div>


        <div class="row g-3 mb-3">

          <div class="col-md-6">
            <label class="form-label">Promotion Start</label>
            <input type="datetime-local" class="form-control" id="promoStartDate" name="promoStartDate">
          </div>

          <div class="col-md-6">
            <label class="form-label">Promotion End</label>
            <input type="datetime-local" class="form-control" id="promoEndDate" name="promoEndDate">
          </div>

        </div>

        <div class="mb-3">
          <label class="form-label">Promotion Banner Text</label>
          <input type="text" class="form-control" id="promoLabel" name="promoLabel" placeholder="e.g. Summer Sale">
        </div>

      </div>

    </div>

    <!--Add and close button-->
    <div class="card-footer text-body-secondary text-end">
      <a class="btn secondary-btn" onclick="document.getElementById('addFlight').close()">Cancel</a>
      <a class="btn primary-btn" onclick="submitAddFlight()">Add Flight</a>
    </div>
  </div>

</dialog>

<!--Edit flight modal-->
<dialog class="w-50" id="editFlight">
  <div class="card">
    <div class="card-header">
      Edit Flight
    </div>
    <div class="card-body">
      <input type="hidden" id="editFlightId">
      <div id="editFlightError" class="alert alert-danger d-none mb-3"></div>

      <div class="row g-3 mb-3 align-items-start">

        <!--Edit Trip Type -->
        <div class="col-md-12">

          <label class="form-label">Trip Type</label>

          <div class="d-flex gap-3">

            <div class="form-check">
              <input class="form-check-input" type="radio" name="editTripType" id="editOneWay" value="oneway">
              <label class="form-check-label" for="editOneWay">One-way</label>
            </div>

            <div class="form-check">
              <input class="form-check-input" type="radio" name="editTripType" id="editRoundTrip" value="round">
              <label class="form-check-label" for="editRoundTrip">Round-trip</label>
            </div>

          </div>

        </div>
      </div>


      <!-- Edit Flight number and flight status-->
      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="form-label" for="editFlightNum">Flight Number</label>
          <input type="text" class="form-control" id="editFlightNum" name="editFlightNum">
        </div>
        <div class="col-md-6">
          <label class="form-label" for="editFlightStatus">Status</label>
          <select class="form-select status-select" id="editFlightStatus" name="editFlightStatus">
            <option value="scheduled">Scheduled</option>
            <option value="delayed">Delayed</option>
            <option value="cancelled">Cancelled</option>
          </select>
        </div>
      </div>

      <!--Edit Airline-->
      <div class="row g-3 mb-3">

        <div class="col-md-12">
          <label class="form-label" for="editAirline">Airline</label>
          <select class="form-select status-select" id="editAirline" name="editAirline">
            <option value="">Select Airline</option>
            {{#each airlines}}
            <option value="{{this}}">{{this}}</option>
            {{/each}}
          </select>
        </div>
      </div>

      <!-- Edit Origin and Destination-->
      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="form-label" for="editFromField">Origin</label>

          <select class="form-select" id="editFromField">
            <option value="">Select Origin</option>
            {{#each airports}}
            <option value="{{this}}">{{this}}</option>
            {{/each}}
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="editToField">Destination</label>

          <select class="form-select" id="editToField">
            <option value="">Select Destination</option>
            {{#each airports}}
            <option value="{{this}}">{{this}}</option>
            {{/each}}
          </select>
        </div>
      </div>

      <!-- Edit Departure and Arrival-->
      <div class="row g-3 mb-3">
        <div class="col-md-6">

          <label class="form-label">Depart Date & Time</label>
          <input type="datetime-local" class="form-control" id="editDepartDate">

        </div>
        <div class="col-md-6">
          <label class="form-label">Arrival Date & Time</label>
          <input type="datetime-local" class="form-control" id="editArrivalDate">
        </div>
      </div>

      <!--Edit Price-->
      <div class="row g-3 mb-3">

        <div class="col-md-12">
          <label class="form-label" for="editPrice">Ticket Price (₱)</label>
          <input type="number" min="0" class="form-control" id="editPrice" name="editPrice">
        </div>
      </div>

      <!--Edit Seats-->
      <div class="row g-3 mb-3">

        <div class="col-md-12">
          <label class="form-label" for="editSeats">Available Seats</label>
          <input type="number" min="0" class="form-control" id="editSeats" name="editSeats">
        </div>
      </div>


      <!-- Edit Promotion -->
      <div class="row g-3 mb-3">

        <div class="col-md-12">

          <div class="form-check">

            <input class="form-check-input" type="checkbox" id="editIsPromo" name="editIsPromo">
            <label class="form-check-label fw-semibold" for="editIsPromo">
              Feature this flight as a promotional offer
            </label>

          </div>

        </div>

      </div>

      <!-- Edit Promotion Details -->
      <div id="editPromoFields" style="display:none;">


        <div class="mb-3">
          <label class="form-label">Discount Value (%)</label>
          <input type="number" class="form-control" id="editDiscountPercent" name="editDiscountPercent" min="0"
            placeholder="e.g. 20">
        </div>

        <div class="row g-3 mb-3">

          <div class="col-md-6">
            <label class="form-label">Promotion Start</label>
            <input type="datetime-local" class="form-control" id="editPromoStartDate" name="editPromoStartDate">
          </div>

          <div class="col-md-6">
            <label class="form-label">Promotion End</label>
            <input type="datetime-local" class="form-control" id="editPromoEndDate" name="editpromoEndDate">
          </div>

        </div>

        <div class="mb-3">
          <label class="form-label">Promotion Banner Text</label>
          <input type="text" class="form-control" id="editPromoLabel" name="editPromoLabel"
            placeholder="e.g. Summer Sale">
        </div>

      </div>

    </div>

    <!--Add and close button-->
    <div class="card-footer text-body-secondary text-end">
      <a class="btn secondary-btn" onclick="document.getElementById('editFlight').close()">Cancel</a>
      <a class="btn primary-btn" onclick="submitEditFlight()">Save Changes</a>
    </div>
  </div>

</dialog>

<!-- Delete confirmation modal -->
<dialog class="w-50" id="deleteFlight">
  <div class="card">
    <div class="card-header">
      Delete Flight
    </div>
    <div class="card-body">
      <input type="hidden" id="deleteFlightId">
      <div id="deleteFlightError" class="alert alert-danger d-none mb-3"></div>
      <p id="deleteFlightConfirmText" class="mb-0">Are you sure you want to delete this flight? This action is
        permanent.</p>
    </div>

    <!--Add and close button-->
    <div class="card-footer text-body-secondary text-end">
      <a class="btn secondary-btn" onclick="document.getElementById('deleteFlight').close()">Cancel</a>
      <a class="btn danger-btn" onclick="submitDeleteFlight()">Delete</a>
    </div>
  </div>

</dialog>