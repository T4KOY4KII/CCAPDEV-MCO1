<!--Edit flight reservation -->
<dialog class="w-50" id="editReservation">
  <div class="card">
    <div class="card-header">
      Update Reservation Status
    </div>
    <div class="card-body">
      <p>Reservation R-001 by Jose Rizal</p>

      <label class="form-control" for="reservationStatus">Assign new reservation status</label>

      <select class="form-select form-select-sm" id="reservationStatus">

        <option value="Pending" selected>Pending</option>
        <option value="Confirmed">Confirmed</option>
        <option value="Completed">Completed</option>
        <option value="Deleted">Deleted</option>

      </select>
    </div>

    <!--Add and close button-->
    <div class="card-footer text-body-secondary text-end">
      <a class="btn secondary-btn" onclick="editReservation.close()">Cancel</a>
      <a class="btn success-btn" onclick="editReservation.close()">Save</a>
    </div>
  </div>

</dialog>