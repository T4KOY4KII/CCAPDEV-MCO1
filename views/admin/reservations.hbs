<!--ADMIN RESERVATION MANAGEMENT PAGE -->

<!-- Search and status filter-->
<div class="container mt-4">
  <div class="table-card mb-3">
    <div class="row g-2 align-items-center">
      <div class="col-md-5">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0">
            <i class="bi bi-search text-muted"></i>
          </span>
          <input type="text" class="form-control border-start-0" id="reservationSearch" placeholder="Search ID, passenger, email, or flight">
        </div>
      </div>

      <div class="col-md-7">
        <select class="form-select" id="reservationStatusFilter">
          <option value="all">Status: All</option>
          <option value="pending">Status: Pending</option>
          <option value="confirmed">Status: Confirmed</option>
          <option value="cancelled">Status: Cancelled</option>
        </select>
      </div>
    </div>
  </div>
</div>

<!-- Reservations table -->
<div class="container">
  <div class="table-card">
    <table class="table table mb-0">
      <thead>
        <tr>
          <th>Reservation ID</th>
          <th>Passenger</th>
          <th>Flight</th>
          <th>Route</th>
          <th>Departure</th>
          <th>Booking Date</th>
          <th>Price</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="TableBody">
        {{#if reservations.length}}
          {{#each reservations}}
            <tr id="reservation-row-{{this._id}}" data-id="{{this._id}}" data-resnum="{{this.reservationNumber}}" data-status="{{this.status}}" data-passenger="{{this.passengerName}}" data-email="{{this.passengerEmail}}" data-flightcode="{{this.flightCode}}" data-origin="{{this.origin}}" data-destination="{{this.destination}}" data-departure="{{this.departureFormatted}}" data-arrival="{{this.arrivalFormatted}}" data-booking="{{this.bookingFormatted}}" data-seat="{{this.seat}}" data-price="{{this.priceFormatted}}">
              <td class="fw-bold">{{this.reservationNumber}}</td>
              <td>{{this.passengerName}}</td>
              <td class="fw-bold">{{this.flightCode}}</td>
              <td>{{this.origin}} <i class="bi bi-arrow-right"></i> {{this.destination}}</td>
              <td>{{this.departureFormatted}}</td>
              <td>{{this.bookingFormatted}}</td>
              <td>₱{{this.priceFormatted}}</td>
              <td><span class="badge badge-{{this.statusBadgeClass}}">{{this.statusCapitalized}}</span></td>
              <td>
                <div class="ms-1">
                  <button class="edit-btn" onclick="openViewReservationModal('{{this._id}}')">
                    <i class="bi bi-eye me-1"></i>
                  </button>
                  <button class="edit-btn" onclick="openEditReservationModal('{{this._id}}')">
                    <i class="bi bi-pencil ms-1"></i>
                  </button>
                  <button class="delete-btn" onclick="openDeleteReservationModal('{{this._id}}', '{{this.reservationNumber}}')">
                    <i class="bi bi-trash3 ms-1"></i>
                  </button>
                </div>
              </td>
            </tr>
          {{/each}}
        {{else}}
          <tr id="noReservationsRow">
            <td colspan="9" class="text-center text-muted py-4">No reservations found in database.</td>
          </tr>
        {{/if}}
      </tbody>
    </table>

    <!-- Pagination -->
    <div class="d-flex justify-content-between align-items-center mt-3 px-2" id="Pagination">
      <button class="btn btn-outline-secondary btn-sm" id="resPrevBtn">
        <i class="bi bi-chevron-left me-1"></i>Back
      </button>
      <span class="res-page-info" id="resPageInfo"></span>
      <button class="btn btn-save btn-sm" id="resNextBtn">
        Next<i class="bi bi-chevron-right ms-1"></i>
      </button>
    </div>
  </div>
</div>

<!--View reservation modal-->
<dialog class="w-50" id="viewReservation">
  <div class="card">
    <div class="card-header">
      Reservation Details
    </div>
    <div class="card-body">
      <div class="passengerInfo">
        <h5>Passenger Information</h5>
        <p id="viewPassengerName">Name: -</p>
        <p id="viewPassengerEmail">Email: -</p>
      </div>

      <hr />

      <div class="flightInfo">
        <h5>Flight Information</h5>
        <p id="viewFlightCode">Flight: -</p>
        <p id="viewFlightRoute">Route: -</p>
        <p id="viewFlightDeparture">Departure: -</p>
        <p id="viewFlightArrival">Arrival: -</p>
      </div>

      <hr />

      <div class="bookingInfo">
        <h5>Booking Information</h5>
        <p id="viewReservationNumber">Reservation ID: -</p>
        <p id="viewBookingDate">Booking Date: -</p>
        <p id="viewSeat">Seat(s): -</p>
        <p id="viewTotalPrice">Total Price: -</p>
      </div>
    </div>

    <div class="card-footer text-body-secondary text-end">
      <a class="btn secondary-btn" onclick="document.getElementById('viewReservation').close()">Close</a>
    </div>
  </div>
</dialog>

<!--Edit flight reservation status modal-->
<dialog class="w-50" id="editReservation">
  <div class="card">
    <div class="card-header">
      Update Reservation Status
    </div>
    <div class="card-body">
      <div id="editReservationError" class="alert alert-danger d-none py-2 mb-3"></div>
      <p id="editReservationTitle" class="fw-bold mb-3">Reservation -</p>
      <input type="hidden" id="editReservationId" />

      <label class="form-label" for="editReservationStatus">Assign new reservation status</label>
      <select class="form-select form-select-sm" id="editReservationStatus">
        <option value="pending">Pending</option>
        <option value="confirmed">Confirmed</option>
        <option value="cancelled">Cancelled</option>
      </select>
    </div>

    <div class="card-footer text-body-secondary text-end">
      <a class="btn secondary-btn" onclick="document.getElementById('editReservation').close()">Cancel</a>
      <a class="btn success-btn" onclick="submitEditReservation()">Save</a>
    </div>
  </div>
</dialog>

<!--Delete reservation confirmation modal-->
<dialog class="w-50" id="deleteReservation">
  <div class="card">
    <div class="card-header">
      Delete Reservation
    </div>
    <div class="card-body">
      <div id="deleteReservationError" class="alert alert-danger d-none py-2 mb-3"></div>
      <p id="deleteReservationConfirmText">Are you sure you want to delete this reservation? This action is permanent.</p>
      <input type="hidden" id="deleteReservationId" />
    </div>
    <div class="card-footer text-body-secondary text-end">
      <a class="btn secondary-btn" onclick="document.getElementById('deleteReservation').close()">Cancel</a>
      <a class="btn delete-btn text-white bg-danger border-0 px-3 py-1 rounded" onclick="submitDeleteReservation()">Delete</a>
    </div>
  </div>
</dialog>