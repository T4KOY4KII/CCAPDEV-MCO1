<!--ADMIN DASHBOARD -->

<!--Top analytics-->
<div class="container">

  <h4 class="fw-bold mb-3">Dashboard Analytics</h4>

  <div class="row">

    <!--Total bookings-->
    <div class="col-lg-4 col-md-6 mb-4">

      <div class="card admin-analytics">

        <div class="card-header">Total Bookings</div>

        <div class="card-body d-flex flex-column align-items-center justify-content-center">

          <h1 class="card-title total-bookings" id="totalBookings1">
            123
          </h1>


          <div class="card-text fw-light d-flex stat-bookings" id="statBookings">
            <i class="bi bi-arrow-up me-2"></i>
            <p class="stat-bookings-info mb-0">15% this month</p>
          </div>

        </div>

      </div>

    </div>

    <!--Revenue-->

    <div class="col-lg-4 col-md-6 mb-4">

      <div class="card admin-analytics">

        <div class="card-header">Revenue</div>

        <div class="card-body d-flex flex-column align-items-center justify-content-center">

          <h1 class="card-title total-bookings" id="totalBookings2">
            ₱10,000
          </h1>


          <div class="card-text fw-light d-flex stat-bookings" id="statBookings">
            <i class="bi bi-arrow-down me-2"></i>
            <p class="stat-bookings-info mb-0">5% this month</p>
          </div>

        </div>

      </div>

    </div>

    <!--Total registered users-->
    <div class="col-lg-4 col-md-6 mb-4">

      <div class="card admin-analytics">

        <div class="card-header">Total Registered Users</div>

        <div class="card-body d-flex flex-column align-items-center justify-content-center">

          <h1 class="card-title total-bookings" id="totalBookings3">
            81
          </h1>


          <div class="card-text fw-light d-flex stat-bookings" id="statBookings">
            <i class="bi bi-arrow-up me-2"></i>
            <p class="stat-bookings-info mb-0">15% this month</p>
          </div>

        </div>

      </div>

    </div>


  </div>

</div>

