<!--ADMIN DASHBOARD -->

<!--Top analytics-->
<div class="container">

  <h4 class="fw-bold mb-3">Dashboard Analytics</h4>

  <div class="row">

    <!--Total bookings-->
    <div class="col-lg-4 col-md-6 mb-4">

      <div class="card admin-analytics">

        <div class="card-header">Total Bookings</div>

        <div class="card-body d-flex flex-column align-items-center justify-content-center">

          <h1 class="card-title total-bookings" id="totalBookings1">
            {{totalBookings}}
          </h1>


          <div class="card-text fw-light d-flex stat-bookings" id="statBookings">
            <i class="bi bi-calendar-check me-2"></i>
            <p class="stat-bookings-info mb-0">{{bookingsStatText}}</p>
          </div>

        </div>

      </div>

    </div>

    <!--Revenue-->

    <div class="col-lg-4 col-md-6 mb-4">

      <div class="card admin-analytics">

        <div class="card-header">Revenue</div>

        <div class="card-body d-flex flex-column align-items-center justify-content-center">

          <h1 class="card-title total-bookings" id="totalBookings2">
            {{formattedRevenue}}
          </h1>


          <div class="card-text fw-light d-flex stat-bookings" id="statBookings">
            <i class="bi bi-wallet me-2"></i>
            <p class="stat-bookings-info mb-0">{{revenueStatText}}</p>
          </div>

        </div>

      </div>

    </div>

    <!--Total registered users-->
    <div class="col-lg-4 col-md-6 mb-4">

      <div class="card admin-analytics">

        <div class="card-header">Total Registered Users</div>

        <div class="card-body d-flex flex-column align-items-center justify-content-center">

          <h1 class="card-title total-bookings" id="totalBookings3">
            {{totalUsers}}
          </h1>


          <div class="card-text fw-light d-flex stat-bookings" id="statBookings">
            <i class="bi bi-people me-2"></i>
            <p class="stat-bookings-info mb-0">{{usersStatText}}</p>
          </div>

        </div>

      </div>

    </div>


  </div>

</div>

<!--Popular destinations -->
<div class="container">
  <div class="col-lg-12 col-md-12 mb-4">

    <div class="card admin-analytics">

      <div class="card-header">Popular Destinations</div>

      <div class="card-body d-flex flex-column">

        {{#if popularDestinations.length}}
          {{#each popularDestinations}}
          <div class="mb-3">
            <div class="d-flex justify-content-between mb-1">
              <span class="dest-label">{{this.destination}}</span>
              <span class="dest-count">{{this.countText}}</span>
            </div>
            <div class="progress" style="height: 22px;">
              <div class="progress-bar" style="width: {{this.percentage}}%; background-color: {{this.color}};">
              </div>
            </div>
          </div>
          {{/each}}
        {{else}}
          <p class="text-muted mb-0 py-3 text-center">No flight bookings recorded yet. Popular destinations will appear here once reservations are placed.</p>
        {{/if}}

      </div>

    </div>


  </div>

</div>