<!--ADMIN USER MANAGEMENT PAGE -->

<!-- Search and filters (role and status) -->
<div class="container mt-4">
  <div class="table-card mb-3">
    <div class="row g-2 align-items-center">
      <div class="col-md-5">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0">
            <i class="bi bi-search text-muted"></i>
          </span>
          <input type="text" class="form-control border-start-0" id="userSearch" placeholder="Search name, email, or number">
        </div>
      </div>

      <div class="col-md-4 ms-auto">
        <select class="form-select" id="roleSort">
          <option value="all">Role: All</option>
          <option value="user">Role: Customer</option>
          <option value="admin">Role: Admin</option>
        </select>
      </div>

      <div class="col-md-3">
        <select class="form-select" id="statusFilter">
          <option value="all">Status: All</option>
          <option value="active">Status: Active</option>
          <option value="deactivated">Status: Deactivated</option>
        </select>
      </div>
    </div>
  </div>
</div>

<!-- Users table -->
<div class="container">
  <div class="table-card">
    <table class="table mb-0">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Number</th>
          <th>Role</th>
          <th>Date Registered</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="TableBody">
        {{#if users.length}}
          {{#each users}}
            <tr id="user-row-{{this._id}}" data-id="{{this._id}}" data-name="{{this.name}}" data-email="{{this.email}}" data-phone="{{this.phone}}" data-role="{{this.role}}" data-status="{{this.status}}" data-date="{{this.dateRegistered}}">
              <td class="fw-bold">{{this.name}}</td>
              <td>{{this.email}}</td>
              <td>{{this.phone}}</td>
              <td>{{this.roleCapitalized}}</td>
              <td>{{this.dateRegistered}}</td>
              <td><span class="badge badge-{{this.statusBadgeClass}}">{{this.statusCapitalized}}</span></td>
              <td>
                <button class="block-button {{#if this.isDeactivated}}text-success{{else}}text-danger{{/if}}" onclick="openToggleUserModal('{{this._id}}', '{{this.name}}', '{{this.status}}')">
                  <i class="bi {{#if this.isDeactivated}}bi-check-circle{{else}}bi-ban{{/if}} ms-4"></i>
                </button>
              </td>
            </tr>
          {{/each}}
        {{else}}
          <tr id="noUsersRow">
            <td colspan="7" class="text-center text-muted py-4">No users found in database.</td>
          </tr>
        {{/if}}
      </tbody>
    </table>

    <!-- Pagination -->
    <div class="d-flex justify-content-between align-items-center mt-3 px-2" id="Pagination">
      <button class="btn btn-outline-secondary btn-sm" id="resPrevBtn">
        <i class="bi bi-chevron-left me-1"></i>Back
      </button>
      <span class="res-page-info" id="resPageInfo"></span>
      <button class="btn btn-save btn-sm" id="resNextBtn">
        Next<i class="bi bi-chevron-right ms-1"></i>
      </button>
    </div>
  </div>
</div>

<!-- Deactivate / Activate user modal -->
<dialog class="w-50" id="blockUser">
  <div class="card">
    <div class="card-header" id="blockUserHeader">
      Deactivate User?
    </div>
    <div class="card-body">
      <div id="blockUserError" class="alert alert-danger d-none py-2 mb-3"></div>
      <p id="blockUserText">This action will change the user's account status.</p>
      <input type="hidden" id="blockUserId" />
    </div>

    <div class="card-footer text-body-secondary text-end">
      <a class="btn secondary-btn" onclick="document.getElementById('blockUser').close()">Cancel</a>
      <a class="btn danger-btn" id="blockUserSubmitBtn" onclick="submitToggleUserStatus()">Deactivate User</a>
    </div>
  </div>
</dialog>