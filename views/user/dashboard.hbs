<!--USER DASHBOARD -->

    <!--Hero section-->
    <div class="container-fluid hero">
        <div class="formcontainer">
            <div class="row">
                <h1 class="fs-50">Every great adventure starts with a buddy.</h1>
                <p class="fs-5">With <strong>TravelBuddy</strong>, you travel happy.</p>
            </div>
        </div>
    </div>

    <!-- Quick flight search widget -->
    <div class="container">

        <div class="search-widget">

            <!-- Top filters-->
            <div class="row g-3 mb-3 align-items-start">

                <!--Trip Type -->
                <div class="col-12 col-md-3">

                    <label class="search-field-label">Trip Type</label>

                    <div class="d-flex gap-3">

                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="tripType" id="oneWay" value="oneway"
                                checked onchange="setTripType(this.value)">
                            <label class="form-check-label" for="oneWay">One-way</label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="tripType" id="roundTrip" value="round"
                                onchange="setTripType(this.value)">
                            <label class="form-check-label" for="roundTrip">Round-trip</label>
                        </div>

                    </div>

                </div>


                <!--Passengers and cabin class -->
                <div class="col-12 col-md-9">

                    <label class="search-field-label">Travelers & Class</label>

                    <div class="dropdown">

                        <button class="btn primary-btn dropdown-toggle" id="passengerCabinBtn" type="button"
                            data-bs-toggle="dropdown" data-bs-display="static">
                            1 adult, Economy
                        </button>

                        <div class="dropdown-menu dropdown-search p-3 ">

                            <h6>Travelers</h6>

                            <!-- Adults -->
                            <div class="d-flex justify-content-between align-items-center mb-6">
                                <span>Adults <p class="fw-lighter fs-6">18+</p></span>

                                <div class="mb-4 mt-0">
                                    <button type="button" class="btn btn-sm btn-light" id="adultsMinus" onclick="changeCount('adults', -1)">
                                        <i class="bi bi-dash-circle"></i>
                                    </button>

                                    <span id="adultsCount" class="mx-2">1</span>

                                    <button class="btn btn-sm btn-light" id="adultsPlus" onclick="changeCount('adults', 1)">
                                        <i class="bi bi-plus-circle"></i>
                                    </button>
                                </div>

                            </div>

                            <!-- Children -->
                            <div class="d-flex justify-content-between align-items-center mb-6">
                                <span>Children<p class="fw-lighter fs-6">2-17</p></span>

                                <div class="mb-4 mt-0">
                                    <button class="btn btn-sm btn-light" id="childrenMinus" onclick="changeCount('children', -1)">
                                        <i class="bi bi-dash-circle"></i>
                                    </button>

                                    <span id="childrenCount" class="mx-2">0</span>

                                    <button class="btn btn-sm btn-light" id="childrenPlus" onclick="changeCount('children', 1)">
                                        <i class="bi bi-plus-circle"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Infants -->
                            <div class="d-flex justify-content-between align-items-center mb-6">
                                <span>Infants<p class="fw-lighter fs-6">under 2</p></span>
                                <div class="mb-4 mt-0">
                                    <button class="btn btn-sm btn-light" id="infantsMinus"onclick="changeCount('infants', -1)">
                                        <i class="bi bi-dash-circle"></i>
                                    </button>

                                    <span id="infantsCount" class="mx-2">0</span>

                                    <button class="btn btn-sm btn-light" id="infantsPlus" onclick="changeCount('infants', 1)">
                                        <i class="bi bi-plus-circle"></i>
                                    </button>
                                </div>
                            </div>

                            <hr />

                            <h6>Cabin Class</h6>

                            <select class="form-select form-select-sm" id="cabinClass" onchange="setCabin(this.value)">

                                <option value="Economy">Economy</option>
                                <option value="Premium Economy">Premium Economy</option>
                                <option value="Business">Business</option>
                                <option value="First Class">First Class</option>

                            </select>

                        </div>

                    </div>

                    <small class="text-danger d-block search-error" id="passengerError"></small>

                </div>

            </div>

            <!-- Search row -->
            <div class="row g-2 align-items-end">

                <!-- Origin -->
                <div class="col-12 col-md-3">
                    <label class="search-field-label">From</label>

                    <select class="form-select" id="fromField">
                        <option value="">Select origin</option>
                        <option>Manila (MNL)</option>
                        <option>Cebu (CEB)</option>
                    </select>

                    <small class="text-danger d-block search-error" id="fromError"></small>
                </div>

                <!-- Destination -->
                <div class="col-12 col-md-3">
                    <label class="search-field-label">To</label>

                    <select class="form-select" id="toField">
                        <option value="">Select destination</option>
                        <option>Singapore (SIN)</option>
                        <option>Hong Kong (HKG)</option>
                    </select>

                    <small class="text-danger d-block search-error" id="toError"></small>
                </div>

                <!-- Dates -->
                <div class="col-12 col-md-6">

                    <div class="row g-2">

                        <!-- Departure -->
                        <div class="col-6">
                            <label class="search-field-label">Depart</label>
                            <input type="date" class="form-control" id="departDate">
                        </div>

                        <!-- Return -->
                        <div class="col-6" id="returnDateWrap">
                            <label class="search-field-label">Return</label>
                            <input type="date" class="form-control" id="returnDate" disabled>
                        </div>

                    </div>

                    <div class="col-12">
                        <small class="text-danger d-block search-error" id="dateError"></small>
                    </div>

                </div>
            </div>

            <!-- Button -->
            <div class="row g-2">
                <div class="col-12 d-flex justify-content-end">
                    <button type="button" class="btn primary-btn" id="searchBtn">
                        <i class="bi bi-search me-1"></i> Search Flights
                    </button>
                </div>
            </div>

        </div>

    </div>

