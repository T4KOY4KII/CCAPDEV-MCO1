    <!--Quick flight search widget-->
    <div class="container">

        <div class="search-widget">

            <!-- Trip type, cabin class, and passenger-->
            <div class="row g-3 mb-3">

                <!--Trip type radio button-->
                <div class="col-12 col-md-auto d-flex flex-column">
                    <label class="search-field-label">Trip Type</label>

                    <div class="d-flex gap-3">

                        <div class="form-check mt-0 mb-0">
                            <input class="form-check-input" type="radio" name="tripType" id="oneWay" value="oneway" checked onchange="setTripType(this.value)"/>
                            <label class="form-check-label" for="oneWay">One-way</label>
                        </div>

                        <div class="form-check mt-0 mb-0">
                            <input class="form-check-input" type="radio" name="tripType" id="roundTrip" value="round" onchange="setTripType(this.value)"/>
                            <label class="form-check-label" for="roundTrip">Round-trip</label>
                        </div>

                    </div>

                </div>


                <!--Passenger and cabin class-->
                <div class="col-12 col-md-auto ms-md-auto d-flex justify-content-md-end">

                    <div class="dropdown">
                        <button class="btn secondary-btn dropdown-toggle" id="passengerCabinBtn" type="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
                            1 adult, Economy
                        </button>

                        <div class="dropdown-menu dropdown-search p-3">

                            <h6>Travelers</h6>
 
                            <!--Adult passenger-->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span>Adults 18+</span>
                                <div>
                                    <button class="btn btn-sm btn-light" onclick="changeCount('adults', -1)"><i class="bi bi-dash-circle"></i></button>
                                    <span id="adultsCount" class="mx-2">1</span>
                                    <button class="btn btn-sm btn-light" onclick="changeCount('adults', 1)"><i class="bi bi-plus-circle"></i></button>
                                </div>
                            </div>

                            <!--Child passenger-->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span>Children 2–17</span>
                                <div>
                                    <button class="btn btn-sm btn-light"
                                        onclick="changeCount('children', -1)"><i class="bi bi-dash-circle"></i></button>
                                    <span id="childrenCount" class="mx-2">0</span>
                                    <button class="btn btn-sm btn-light" onclick="changeCount('children', 1)"><i class="bi bi-plus-circle"></i></button>
                                </div>
                            </div>

                            <!--Infant passenger-->
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span>Infants under 2</span>
                                <div>
                                    <button class="btn btn-sm btn-light" onclick="changeCount('infants', -1)"><i class="bi bi-dash-circle"></i></button>
                                    <span id="infantsCount" class="mx-2">0</span>
                                    <button class="btn btn-sm btn-light" onclick="changeCount('infants', 1)"><i class="bi bi-plus-circle"></i></button>
                                </div>
                            </div>

                            <!--TO DO: WARNING ON PASSENGER LIMIT -->
                            <div id="passengerWarning" class="text-danger small mt-2">
                                test
                            </div>


                            <hr/>

                            <h6>Cabin Class</h6>


                             <!--Cabin class dropdown-->
                            <div class="d-grid gap-2">

                                <select class="form-select form-select-sm w-auto" id="cabinClass" onchange="setCabin(this.value)">
                                    <option value="Economy">Economy</option>
                                    <option value="Premium Economy">Premium Economy</option>
                                    <option value="Business">Business</option>
                                    <option value="First Class">First Class</option>
                                </select>

                            </div>

                        </div>

                    </div>

                </div>


            </div>

            <!--Search fields (orgin+destination and departure+arrival)-->
            <div class="row g-2 align-items-end">

                <!--Origin picker-->
            <div class="col-12 col-md-3">
                <label class="search-field-label">From</label>
                <select class="form-select" id="fromField">
                    <option value="">Select Origin</option>
                    {{#each airports}}
                    <option value="{{this}}">{{this}}</option>
                    {{/each}}
                </select>
                <small class="text-danger d-block search-error" id="fromError"></small>
            </div>

                <!--Destination picker-->
             <div class="col-12 col-md-3">
                <label class="search-field-label">To</label>
                <select class="form-select" id="toField">
                    <option value="">Select Destination</option>
                    {{#each airports}}
                    <option value="{{this}}">{{this}}</option>
                    {{/each}}
                </select>
                <small class="text-danger d-block search-error" id="toError"></small>
            </div>

                <!--Departure date picker-->
                <div class="col-12 col-md">
                    <label class="search-field-label" for="departDate">Depart</label>
                    <input type="date" class="form-control" id="departDate" />
                </div>

                <!--Return date picker-->
                <div class="col-12 col-md" id="returnDateWrap">
                    <label class="search-field-label" for="returnDate">Return</label>
                    <input type="date" class="form-control" id="returnDate" disabled/> 
                </div>
            </div>

            <div class="row g-2 mt-2 align-items-end">

                <!--Search button-->
                <div class="col-12 col-md-auto">
                    <button class="btn primary-btn" id="searchBtn">
                        <i class="bi bi-search me-1"></i> Search Flights
                    </button>
                </div>

                <!-- Advanced search dropdown -->
                <div class="col-12 col-md-auto mt-2">

                    <!-- Advanced search button -->
                    <button class="btn dropdown-toggle border-0" id="advSearchBtn" data-bs-toggle="dropdown" aria-expanded="false" data-bs-display="static">
                        Advanced Search
                    </button>

                    <!-- Advanced search form  -->
                     <div class="dropdown-menu col-12" id="advSearchDrpDwn">
                        <form class="px-4 py-3">
                            <h6>ADVANCED FILTER</h6>

                            <!-- Airline picker -->
                            <div class="mb-3">
                                <label class="search-field-label" for="airlineField">Airline</label>

                                <select class="form-select" id="airlineField">
                                    <option value="">Select Airline</option>
                                    <option value="Philippine Airlines">Philippine Airlines</option>
                                    <option value="Cebu Pacific">Cebu Pacific</option>
                                    <option value="Royal Air Philippines">Royal Air Philippines</option>
                                    <option value="AirAsia">Philippines AirAsia</option>
                                </select>
                            </div>

                            <!-- Price range -->
                            <div class="price-container col-12 col-md-auto d-flex flex-column">
                                <label class="search-field-label">
                                    Price Range: <span class="priceValue">₱15,000</span>
                                </label>

                                <input type="range" class="form-range w-50 priceRange" min="0" max="15000" step="100" value="15000">
                            </div>

                            <!-- flexible dates and direct flights radios -->
                            <div class="col-12 col-md-auto ms-md-auto d-flex justify-content-md-end">
                                <div class="d-flex gap-3">

                                    <div class="form-check mt-0 mb-0">
                                        <input class="form-check-input" name="flightType" type="radio" id="flexiDates" value="flexible"/>
                                        <label class="form-check-label" for="flexiDates">Flexible Dates</label>
                                    </div>

                                    <div class="form-check mt-0 mb-0">
                                        <input class="form-check-input" name="flightType" type="radio" id="dirFlight" value="direct"/>
                                        <label class="form-check-label" for="dirFlight">Direct Flights Only</label>
                                    </div>
                                </div>
                            </div>

                        </form>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Page Content -->
    <div class="container d-flex">

        <!-- Filter Sidebar -->

        <div class="filter-sidebar p-3">

            <div class="container-fluid flex-lg-column align-items-stretch">
                <h6 class="pb-2 mb-2 border-bottom">Filter Results</h6>

                <!-- Check Airlines -->

                <p class="mb-1">Airlines</p>

                <div class="p-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="" id="phAir" data-airline="Philippine Airlines">
                        <label class="form-check-label" for="phAir">
                            Philippine Airlines
                        </label>
                    </div> 

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="" id="cebPac" data-airline="Cebu Pacific">
                        <label class="form-check-label" for="cebPac">
                            Cebu Pacific
                        </label>
                    </div>   

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="" id="royalAirPh" data-airline="Royal Air Philippines">
                        <label class="form-check-label" for="royalAirPh">
                            Royal Air Philippines
                        </label>
                    </div>
                        
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="" id="airAsia" data-airline="AirAsia">
                        <label class="form-check-label" for="airAsia">
                            Philippine AirAsia
                        </label>
                    </div> 
                </div>

                <!-- Check Stops -->

                <p class="mb-1">Stops</p>

                <div class="p-2">
                    <div class="form-check mt-0 mb-0">
                        <input class="form-check-input" type="radio" name="stopType" id="direct" value="direct"/>
                        <label class="form-check-label" for="direct">Direct</label>
                    </div>

                    <div class="form-check mt-0 mb-0">
                        <input class="form-check-input" type="radio" name="stopType" id="onestop" value="oneStop"/>
                        <label class="form-check-label" for="oneWay">1 Stop</label>
                    </div> 

                    <div class="form-check mt-0 mb-0">
                        <input class="form-check-input" type="radio" name="stopType" id="twostops" value="twoStops"/>
                        <label class="form-check-label" for="moreWays">2+ Stops</label>
                    </div>
                </div>

                <!-- Check Departure Schedules -->

                <p class="mb-1">Departure Schedules</p>
                <div class="col-12 col-md">
                    <label class="search-field-label" for="departSched"></label>
                    <input type="date" class="form-control" id="departSched" />
                </div>

                <!-- Price Ranges -->

                <p class="price-container mt-2 mb-0"> 
                    <label class="search-field-label">
                        Price Range: 
                        <span class="priceValue">₱15,000</span>
                    </label>

                        <input type="range" class="form-range priceRange" min="0" max="15000" step="100" value="15000">
                </p>

                 <!-- Reset button -->

                <div class="col-12">
                    <button class="btn btn-primary w-100" id="resetFltrsBtn">Reset Filters</button>
                </div>
            </div>
        </div>

        <!-- Search Results -->

        <div class="search-results pt-3 ps-3">

            <!-- Search results heading and sort dropdown -->
            
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">

                <!-- Heading -->

                <h6 class="mb-0">
                    Showing
                    <span id="resultsCount"></span>
                </h6>

                <!-- Sort Dropdown -->

                <div class="d-flex align-items-center gap-2">
                    <label class="small mb-0" for="sortSelect">Sort by:</label>
                    
                    <select class="form-select" id="sortSelect" style="width:auto">
                        <option value="price-asc">Price: Low to High</option>
                        <option value="price-desc">Price: High to Low</option>
                        <option value="depart-asc">Departure: Earliest</option>
                        <option value="depart-desc">Departure: Latest</option>
                        <option value="duration-asc">Duration: Shortest</option>
                    </select>

                </div>
            </div>

            {{#each flights}}
              <div class="card flight-card text-center"
                  data-airline="{{this.airline}}" data-stops="{{this.stops}}"
                  data-trip-type="{{this.tripType}}" data-price="{{this.discountedPrice}}"
                  data-depart-date="{{this.departureDate}}" data-depart-time="{{this.departureTime}}"
                  data-duration="{{this.flightDuration}}" data-origin="{{this.origin}}"
                  data-destination="{{this.destination}}" data-seats="{{this.availableSeats}}">
                  <div class="card-header">
                      <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                      <span class="flight-airline">{{this.airline}}</span>
                      <span class="badge bg-secondary">{{flightCode}}</span>

                      <!-- Status badge -->
                      {{#if (eq status 'delayed')}}
                      <span class="badge bg-warning text-dark">
                          <i class="bi bi-clock me-1"></i>Delayed
                      </span>
                      {{else if (eq status 'cancelled')}}
                      <span class="badge bg-danger">
                          <i class="bi bi-x-circle me-1"></i>Cancelled
                      </span>
                      {{else}}
                      <span class="badge bg-success">
                          <i class="bi bi-check-circle me-1"></i>On Time
                      </span>
                      {{/if}}

                  </div>

                  <div class="mt-3">
                      {{#if this.availableSeats}}
                      <span class="seats-left">
                          <i class="bi bi-person-fill me-1"></i>{{this.availableSeats}} seats left
                      </span>
                      {{else}}
                      <span class="badge bg-danger">Sold Out</span>
                      {{/if}}
                  </div>

                      
                </div>
              </div>

              <!-- Middle row: times, route, price -->
              <div class="card-body">
                  <div class="row align-items-center g-3">

                      <!-- Departure -->
                      <div class="col-6 col-md-2 flight-time-block">
                          <div class="flight-date">{{this.departureDate}}</div>
                          <div class="flight-time">{{this.departureTime}}</div>
                          <div class="flight-country">{{this.origin}}</div>
                      </div>

                      <!-- Route line -->
                      <div class="col-12 col-md-6 flight-route-block">
                          <div class="flight-route-label">
                              {{this.origin}} <i class="bi bi-arrow-right"></i> {{this.destination}}
                          </div>
                          <div class="flight-route-line">
                              <hr />
                          </div>
                          <div class="flight-route-info">
                              Direct | {{this.flightDuration}}
                          </div>
                      </div>

                      <!-- Arrival -->
                      <div class="col-6 col-md-2 flight-time-block">
                          <div class="flight-date">{{this.arrivalDate}}</div>
                          <div class="flight-time">{{this.arrivalTime}}</div>
                          <div class="flight-country">{{this.destination}}</div>
                      </div>

                      <!-- Price -->
                      <div class="col-12 col-md-2 flight-price-block text-center">

                          {{#if this.discountPercent}}
                          <!-- Show original and discounted price -->
                          <div class="text-muted text-decoration-line-through small">
                              ₱{{this.price}}
                          </div>
                          <div class="flight-price text-danger fw-bold">
                              ₱{{this.discountedPrice}}
                          </div>
                          <span class="badge bg-danger mb-1">-{{this.discountPercent}}%</span>
                          {{else}}
                          <div class="flight-price">₱{{this.price}}</div>
                          {{/if}}

                          {{#if this.availableSeats}}
                          <a href="/flight/{{_id}}" class="btn primary-btn btn-sm px-4 mt-2">
                              Book
                          </a>
                          {{else}}
                          <button class="btn btn-secondary btn-sm px-4 mt-2" disabled>
                              Sold Out
                          </button>
                          {{/if}}

                      </div>

                  </div>
              </div>

              <!-- Footer: toggle details -->
              <div class="card-footer text-end">
                  <button class="secondary-btn" id="detailsToggle{{_id}}"
                      onclick="toggleDetails('flightDetails{{_id}}', 'detailsToggle{{_id}}')">
                      View Details <i class="bi bi-chevron-down"></i>
                  </button>
              </div>

              <!-- Expandable details panel -->
              <div class="flight-details d-none" id="flightDetails{{_id}}">
                  <div class="flight-details-grid">

                      <div class="detail-item">
                          <div class="detail-label">Flight Code</div>
                          <div class="detail-value">{{this.flightCode}}</div>
                      </div>

                      <div class="detail-item">
                          <div class="detail-label">Airline</div>
                          <div class="detail-value">{{this.airline}}</div>
                      </div>

                      <div class="detail-item">
                          <div class="detail-label">Trip Type</div>
                          <div class="detail-value text-capitalize">{{this.tripType}}</div>
                      </div>

                      <div class="detail-item">
                          <div class="detail-label">Duration</div>
                          <div class="detail-value">{{this.flightDuration}}</div>
                      </div>

                      <div class="detail-item">
                          <div class="detail-label">Status</div>
                          <div class="detail-value text-capitalize">{{this.status}}</div>
                      </div>

                      <div class="detail-item">
                          <div class="detail-label">Seats Available</div>
                          <div class="detail-value">{{this.availableSeats}}</div>
                      </div>

                      {{#if this.discountPercent}}
                      <div class="detail-item">
                          <div class="detail-label">Promo</div>
                          <div class="detail-value text-danger">
                              {{this.discountPercent}}% OFF — ends {{this.promoEndFormatted}}
                          </div>
                      </div>
                      {{/if}}

                  </div>
              </div>

          </div>
          {{/each}}

              <!-- No results message -->
              <div id="noResultsMsg" class="text-center text-muted mt-5 {{#unless hasFlights}}{{else}}d-none{{/unless}}">
                <i class="bi bi-emoji-frown fs-3 d-block mb-1"></i>
                No flights found. Try adjusting or resetting your filters.
              </div>

            </div>
          
        </div>
     
    </div>
