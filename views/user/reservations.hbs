<!--USER RESERVATIONS PAGE -->

<!-- Page Content -->
<div class="container py-4">

  <h4 class="fw-bold mb-1">Reservations</h4>
  <p class="page-description mb-4">View and manage all your flight bookings in one place.</p>

  <!-- Search, Sort, Filter controls -->
  <div class="reservations-card mb-3">
    <div class="row g-2 align-items-center">
      <div class="col-md-5">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0">
            <i class="bi bi-search text-muted"></i>
          </span>
          <input type="text" class="form-control border-start-0" id="reservationSearch" placeholder="Search flights">
        </div>
      </div>
      <div class="col-md-4 ms-auto">
        <select class="form-select" id="reservationSort">
          <option value="newest">Sort: newest first</option>
          <option value="oldest">Sort: oldest first</option>
        </select>
      </div>
      <div class="col-md-3">
        <select class="form-select" id="reservationFilter">
          <option value="all">Filter: all</option>
          <option value="confirmed">Filter: confirmed</option>
          <option value="pending">Filter: pending</option>
          <option value="cancelled">Filter: cancelled</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Reservations table -->
  <div class="reservations-card">
    <table class="table reservations-table mb-0">
      <thead>
        <tr>
          <th>Reference</th>
          <th>Name</th>
          <th>Flight</th>
          <th>Seat</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <script id="reservationsData" type="application/json">{{{reservationsJSON}}}</script>
      <tbody id="reservationsTableBody"></tbody>
    </table>

    <!-- Empty state -->
    <div id="reservationsEmpty" class="text-center py-5 d-none">
      <i class="bi bi-inbox text-muted" style="font-size: 2rem;"></i>
      <p class="text-muted mt-2 mb-0">No reservations found.</p>
    </div>

    <!-- Pagination -->
    <div class="d-flex justify-content-between align-items-center mt-3 px-2" id="reservationsPagination">
      <button class="btn btn-outline-secondary btn-sm" id="resPrevBtn">
        <i class="bi bi-chevron-left me-1"></i>Back
      </button>
      <span class="res-page-info" id="resPageInfo"></span>
      <button class="btn btn-save btn-sm" id="resNextBtn">
        Next<i class="bi bi-chevron-right ms-1"></i>
      </button>
    </div>
  </div>

</div>

<!-- VIEW DETAILS MODAL -->

<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content res-modal-content">

      <div class="modal-body p-4">
        <h5 class="fw-bold mb-3">Reservation Details</h5>

        <p class="res-modal-meta mb-1">Reservation Number</p>
        <p class="fw-semibold mb-3" id="modalResNumber"></p>

        <p class="res-modal-meta mb-1">Flight Number</p>
        <p class="fw-semibold mb-3" id="modalFlightNumber"></p>

        <p class="res-modal-meta mb-1">Passenger Name</p>
        <p class="fw-semibold mb-3" id="modalPassengerName"></p>

        <p class="res-modal-meta mb-1">Status</p>
        <p class="fw-semibold mb-3" id="modalStatus"></p>

        <p class="res-modal-meta mb-1">Seat</p>
        <div class="d-flex align-items-center gap-2 mb-3">
          <span id="modalSeatDisplay" class="fw-semibold"></span>
          <input type="text" class="form-control form-control-sm d-none" id="modalSeatInput" style="max-width: 100px;">
        </div>
      </div>

      <div class="modal-footer res-modal-footer">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
          <i class="bi bi-chevron-left me-1"></i>Return
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="modalEditBtn">Edit Seat</button>
        <button type="button" class="btn btn-save btn-sm d-none" id="modalSaveSeatBtn">Save Seat</button>
        <button type="button" class="btn btn-save btn-sm" id="modalCancelBtn">Cancel Booking</button>
      </div>

    </div>
  </div>
</div>

<!-- CANCEL CONFIRMATION MODAL -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content res-modal-content">
      <div class="modal-body p-4 text-center">
        <i class="bi bi-exclamation-circle text-danger mb-3" style="font-size: 2rem;"></i>
        <p class="fw-bold mb-1">Cancel this booking?</p>
        <p class="text-muted" style="font-size:13px;" id="cancelModalRef"></p>
      </div>
      <div class="modal-footer res-modal-footer justify-content-center">
        <button type="button" class="btn btn-outline-secondary btn-sm" id="cancelModalNoBtn">Keep it</button>
        <button type="button" class="btn btn-danger btn-sm" id="cancelModalYesBtn">Yes, cancel</button>
      </div>
    </div>
  </div>
</div>