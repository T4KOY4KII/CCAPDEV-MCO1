<!--USER BOOKING PAGE -->


<!--Booking Wizard-->
<form class="form-wizard">

  <!-- Progress stepper -->
  <div class="progress-container">
    <div class="progress"></div>
    <ol>
      <li class="current">Your Details</li>
      <li>Packages</li>
      <li>Check and Pay</li>
    </ol>
  </div>

  <!-- Steps container -->
  <div class="steps-container">

    <!-- STEP 1: Passenger Info -->
    <div class="step">
      <div class="d-flex gap-4">

        <!-- Passenger form -->
        <div class="passenger-container flex-grow-1">
          <h3 class="w-100 px-3 pt-2 mb-3">Passenger Information</h3>

          <!-- Name row -->
          <div class="d-flex gap-3 w-100 px-3 mb-3">
            <div class="flex-grow-1">
              <label class="form-label">First Name</label>
              <input type="text" class="form-control" id="firstName" placeholder="First name">
            </div>
            <div class="flex-grow-1">
              <label class="form-label">Last Name</label>
              <input type="text" class="form-control" id="lastName" placeholder="Last name">
            </div>
          </div>

          <!-- Contact number -->
          <div class="w-100 px-3 mb-3">
            <label class="form-label">Contact Number</label>
            <div class="d-flex gap-2">
              <select class="form-select" style="max-width:100px" id="contactCode">
                <option value="+63">+63</option>
                <option value="+1">+1</option>
                <option value="+44">+44</option>
                <option value="+61">+61</option>
                <option value="+55">+55</option>
              </select>
              <input type="text" class="form-control" id="contactNumber" placeholder="9XXXXXXXXX">
            </div>
          </div>

          <!-- Email -->
          <div class="w-100 px-3 mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" id="email" placeholder="email@example.com">
          </div>

          <!-- Passport + Nationality -->
          <div class="d-flex gap-3 w-100 px-3 mb-3">
            <div class="flex-grow-1">
              <label class="form-label">Passport Number</label>
              <input type="text" class="form-control" id="passportNumber" placeholder="P1234567">
            </div>
            <div class="flex-grow-1">
              <label class="form-label">Nationality</label>
              <select class="form-select" id="nationality">
                <option value="">Select nationality</option>
                <option value="Filipino">Filipino</option>
                <option value="American">American</option>
                <option value="British">British</option>
                <option value="Australian">Australian</option>
                <option value="Japanese">Japanese</option>
                <option value="Singaporean">Singaporean</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>

          <!-- DOB + Gender -->
          <div class="d-flex gap-3 w-100 px-3 mb-3">
            <div class="flex-grow-1">
              <label class="form-label">Date of Birth</label>
              <div class="d-flex gap-1">
                <input type="text" class="form-control text-center" id="dobMonth" placeholder="MM" maxlength="2"
                  style="max-width:64px">
                <input type="text" class="form-control text-center" id="dobDay" placeholder="DD" maxlength="2"
                  style="max-width:64px">
                <input type="text" class="form-control text-center" id="dobYear" placeholder="YYYY" maxlength="4"
                  style="max-width:90px">
              </div>
            </div>
            <div class="flex-grow-1">
              <label class="form-label">Gender</label>
              <select class="form-select" id="gender">
                <option value="">Select gender</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Prefer not to say">Prefer not to say</option>
              </select>
            </div>
          </div>

          <!-- Emergency contact -->
          <div class="w-100 px-3 mb-3">
            <label class="form-label">Emergency Contact</label>
            <div class="d-flex gap-2">
              <select class="form-select" style="max-width:100px" id="emergencyCode">
                <option value="+63">+63</option>
                <option value="+1">+1</option>
                <option value="+44">+44</option>
              </select>
              <input type="text" class="form-control" id="emergencyContact" placeholder="9XXXXXXXXX">
            </div>
          </div>

        </div>

        <!-- Booking summary sidebar -->
        <div class="booking-summary-sidebar">
          <h5 class="mb-3">Booking Summary</h5>

          <!-- Flight details -->
          <div class="summary-section mb-3">
            <div class="d-flex justify-content-between align-items-center">
              <span class="summary-route fw-bold">{{flight.origin}} – {{flight.destination}}</span>
              <button type="button" class="btn btn-link btn-sm p-0" onclick="toggleSummarySection('flightDetails')">
                Show flight details <i class="bi bi-chevron-down" id="flightDetailsIcon"></i>
              </button>
            </div>
            <div class="text-muted small">{{flight.departureDateFormatted}} · {{flight.departureTimeFormatted}} - {{flight.arrivalTimeFormatted}}</div>
            <div id="flightDetails" class="summary-expandable d-none mt-2">
              <div class="summary-timeline">
                <div class="timeline-row">
                  <div class="timeline-time">{{flight.departureDateFormatted}}<br>{{flight.departureTimeFormatted}}</div>
                  <div class="timeline-dot-col">
                    <div class="timeline-dot"></div>
                    <div class="timeline-line"></div>
                  </div>
                  <div class="timeline-info">
                    <div class="timeline-label">Departure</div>
                    <div class="timeline-value">{{flight.origin}}</div>
                  </div>
                </div>
                <div class="timeline-row">
                  <div class="timeline-time">{{flight.arrivalDateFormatted}}<br>{{flight.arrivalTimeFormatted}}</div>
                  <div class="timeline-dot-col">
                    <div class="timeline-dot"></div>
                  </div>
                  <div class="timeline-info">
                    <div class="timeline-label">Arrival</div>
                    <div class="timeline-value">{{flight.destination}}</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <hr>

          <!-- Passenger count -->
          <div class="summary-section mb-3">
            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-semibold" style="font-size:14px">Passenger Count</span>
              <button type="button" class="btn btn-link btn-sm p-0" onclick="toggleSummarySection('passengerDetails')">
                Show details <i class="bi bi-chevron-down" id="passengerDetailsIcon"></i>
              </button>
            </div>
            <div id="passengerDetails" class="summary-expandable d-none mt-2 small text-muted">
              <div>Total Capacity: 100</div>
              <div>Passengers (50)</div>
              <div>Crew (5)</div>
            </div>
          </div>
          <hr>

          <!-- Selected seat -->
          <div class="summary-section mb-3">
            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-semibold" style="font-size:14px">Selected seat(s)</span>
              <button type="button" class="btn btn-link btn-sm p-0" onclick="toggleSummarySection('seatDetails')">
                Show details <i class="bi bi-chevron-down" id="seatDetailsIcon"></i>
              </button>
            </div>
            <div class="small text-muted js-seat-label">Seat: not selected yet</div>
            <div id="seatDetails" class="summary-expandable d-none mt-2 small text-muted">
              <div class="d-flex justify-content-between"><span class="js-seat-detail-label">No seat selected</span><span class="js-seat-price">{{pricingDisplay.zero}}</span></div>
            </div>
          </div>
          <hr>

          <!-- Meal package -->
          <div class="summary-section mb-3">
            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-semibold" style="font-size:14px">Meal package</span>
              <button type="button" class="btn btn-link btn-sm p-0" onclick="toggleSummarySection('mealDetails')">
                Show details <i class="bi bi-chevron-down" id="mealDetailsIcon"></i>
              </button>
            </div>
            <div class="small text-muted" id="selectedMealLabel">Standard</div>
            <div id="mealDetails" class="summary-expandable d-none mt-2 small text-muted">
              <div class="d-flex justify-content-between"><span id="mealDetailName">Standard</span><span class="js-meal-price">{{pricingDisplay.zero}}</span>
              </div>
            </div>
          </div>
          <hr>

          <!-- Extra services -->
          <div class="summary-section mb-3">
            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-semibold" style="font-size:14px">Extra services</span>
              <button type="button" class="btn btn-link btn-sm p-0" onclick="toggleSummarySection('extrasDetails')">
                Show details <i class="bi bi-chevron-down" id="extrasDetailsIcon"></i>
              </button>
            </div>
            <div class="small text-muted"><span class="js-baggage-count">1</span> pc checked bag (24kg)</div>
            <div id="extrasDetails" class="summary-expandable d-none mt-2">
              <div class="d-flex justify-content-between small text-muted mb-1"><span>Checked bag (×<span class="js-baggage-count">1</span>)</span><span class="js-baggage-price">{{pricingDisplay.baggagePerUnit}}</span></div>
              <div class="d-flex justify-content-between small text-muted js-addon-priority-row"><span>Priority boarding</span><span class="js-addon-priority-price">{{pricingDisplay.zero}}</span></div>
              <div class="d-flex justify-content-between small text-muted js-addon-insurance-row"><span>Travel insurance</span><span class="js-addon-insurance-price">{{pricingDisplay.zero}}</span></div>
              <div class="d-flex justify-content-between small text-muted js-addon-lounge-row"><span>Lounge access</span><span class="js-addon-lounge-price">{{pricingDisplay.zero}}</span></div>
            </div>
          </div>
          <hr>

          <!-- Taxes and fees -->
          <div class="summary-section mb-3">
            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-semibold" style="font-size:14px">Taxes and fees</span>
              <button type="button" class="btn btn-link btn-sm p-0" onclick="toggleSummarySection('taxDetails')">
                Show details <i class="bi bi-chevron-down" id="taxDetailsIcon"></i>
              </button>
            </div>
            <div id="taxDetails" class="summary-expandable d-none mt-2 small text-muted">
              <div class="d-flex justify-content-between mb-1"><span>Subtotal</span><span class="js-subtotal-price">{{pricingDisplay.basePrice}}</span>
              </div>
              <div class="d-flex justify-content-between fw-semibold mt-1"><span>Taxes & fees ({{pricingDisplay.taxRatePercent}}%)</span><span class="js-tax-price">{{pricingDisplay.zero}}</span></div>
            </div>
          </div>
          <hr>

          <!-- Total -->
          <div class="d-flex justify-content-between align-items-center mt-2">
            <div>
              <div class="fw-bold" style="font-size:18px">Total</div>
              <div class="text-muted small">Includes taxes and fees</div>
            </div>
            <div class="fw-bold js-total" style="font-size:20px" id="grandTotal">{{pricingDisplay.basePrice}}</div>
          </div>

        </div>
      </div>
    </div>

    <!-- STEP 2: Optional Packages -->
    <div class="step">
      <div class="d-flex gap-4">

        <!-- Packages left column -->
        <div class="flex-grow-1">

          <!-- Meal selection -->
          <div class="meal-container w-100 mb-3">
            <div class="d-flex justify-content-between align-items-center w-100 px-3 pt-2 mb-2">
              <h5 class="mb-0"><i class="bi bi-cup-hot me-2"></i>Meals</h5>
            </div>
            <div class="w-100 px-3 pb-2" id="mealOptions">
              {{#each mealOptions}}
              <div class="meal-option {{#if @first}}active{{/if}}" data-meal="{{this.value}}" data-price="{{this.price}}" onclick="selectMeal('{{this.value}}')">
                <span>{{this.label}}</span>
                <small class="text-muted ms-2">{{this.priceFormatted}}</small>
                {{#if @first}}<i class="bi bi-check2 ms-auto"></i>{{/if}}
              </div>
              {{/each}}
            </div>
          </div>

          <!-- Seat selection -->
          <div class="seat-container w-100 mb-3">
            <div class="w-100 px-3 pt-2">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0"><i class="bi bi-person-workspace me-2"></i>Seat</h5>
                <span class="text-muted small" id="selectedSeatLabel">Seat: None selected</span>
              </div>

              <!-- Legend -->
              <div class="d-flex gap-3 flex-wrap mb-3">
                <div class="d-flex align-items-center gap-1">
                  <div class="seat-legend premium"></div><small>Premium (+{{pricingDisplay.seatPremiumSurcharge}})</small>
                </div>
                <div class="d-flex align-items-center gap-1">
                  <div class="seat-legend selected"></div><small>Selected</small>
                </div>
                <div class="d-flex align-items-center gap-1">
                  <div class="seat-legend available"></div><small>Available</small>
                </div>
                <div class="d-flex align-items-center gap-1">
                  <div class="seat-legend occupied"></div><small>Occupied</small>
                </div>
              </div>

              <div class="text-muted small mb-3">
                <i class="bi bi-info-circle me-1"></i>
                Guests with no pre-selected seats will be randomly assigned a seat at check-in
              </div>

              <!-- Seat map -->
              <div class="seat-map mb-3" id="seatMap">
                {{#each seatMap}}
                <div class="seat-row">
                  <span class="row-num">{{this.rowNum}}</span>
                  <div class="seat-group">
                    {{#each this.leftSeats}}
                    <button type="button" class="{{this.cssClass}}" data-seat="{{this.id}}" data-premium="{{this.isPremium}}" {{#if this.isOccupied}}disabled{{else}}onclick="selectSeat(this)"{{/if}}>{{this.letter}}</button>
                    {{/each}}
                  </div>
                  <div class="seat-aisle"></div>
                  <div class="seat-group">
                    {{#each this.rightSeats}}
                    <button type="button" class="{{this.cssClass}}" data-seat="{{this.id}}" data-premium="{{this.isPremium}}" {{#if this.isOccupied}}disabled{{else}}onclick="selectSeat(this)"{{/if}}>{{this.letter}}</button>
                    {{/each}}
                  </div>
                  <span class="row-num">{{this.rowNum}}</span>
                </div>
                {{/each}}
              </div>

            </div>
          </div>

          <!-- Extra services -->
          <div class="extra-services-container w-100 mb-3">
            <div class="w-100 px-3 pt-2 pb-3">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Extra Services</h5>
                <div class="form-check form-switch mb-0">
                  <input class="form-check-input" type="checkbox" id="extrasToggle" checked
                    onchange="toggleExtras(this.checked)">
                </div>
              </div>

              <div id="extrasContent">
                <!-- Additional baggage -->
                <div class="extra-row mb-3">
                  <div>
                    <div class="fw-semibold small">Additional baggage</div>
                    <div class="text-muted small">Weight: 24kg</div>
                    <div class="text-muted small">{{pricingDisplay.baggagePerUnit}} per bag</div>
                  </div>
                  <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-light" onclick="changeBaggage(-1)"><i
                        class="bi bi-dash"></i></button>
                    <span id="baggageCount">1</span>
                    <button type="button" class="btn btn-sm btn-light" onclick="changeBaggage(1)"><i
                        class="bi bi-plus"></i></button>
                  </div>
                </div>

                <!-- Priority boarding -->
                <div class="extra-row mb-3">
                  <div>
                    <div class="fw-semibold small">Priority boarding</div>
                    <div class="text-muted small">{{pricingDisplay.priorityBoardingPrice}}</div>
                  </div>
                  <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="priorityBoarding" onchange="recalculateTotals()">
                  </div>
                </div>

                <!-- Travel insurance -->
                <div class="extra-row mb-3">
                  <div>
                    <div class="fw-semibold small">Travel insurance</div>
                    <div class="text-muted small">{{pricingDisplay.travelInsurancePrice}}</div>
                  </div>
                  <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="travelInsurance" onchange="recalculateTotals()">
                  </div>
                </div>

                <!-- Lounge access -->
                <div class="extra-row">
                  <div>
                    <div class="fw-semibold small">Lounge access</div>
                    <div class="text-muted small">{{pricingDisplay.loungeAccessPrice}}</div>
                  </div>
                  <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="loungeAccess" onchange="recalculateTotals()">
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>

        <!-- Booking summary sidebar (same as step 1) -->
        <div class="booking-summary-sidebar">
          <h5 class="mb-3">Booking Summary</h5>
          <div class="summary-section mb-3">
            <div class="fw-bold">{{flight.origin}} – {{flight.destination}}</div>
            <div class="text-muted small">{{flight.departureDateFormatted}} · {{flight.departureTimeFormatted}} - {{flight.arrivalTimeFormatted}}</div>
          </div>
          <hr>
          <div class="d-flex justify-content-between small mb-2"><span>Base fare</span><span class="js-base-fare">{{pricingDisplay.basePrice}}</span></div>
          <div class="d-flex justify-content-between small mb-2"><span class="js-seat-row-label">Seat</span><span class="js-seat-price">{{pricingDisplay.zero}}</span></div>
          <div class="d-flex justify-content-between small mb-2"><span>Meal</span><span class="js-meal-price">{{pricingDisplay.zero}}</span></div>
          <div class="d-flex justify-content-between small mb-2"><span>Baggage (×<span class="js-baggage-count">1</span>)</span><span class="js-baggage-price">{{pricingDisplay.baggagePerUnit}}</span></div>
          <div class="d-flex justify-content-between small mb-2 js-addons-row"><span>Add-ons</span><span class="js-addons-price">{{pricingDisplay.zero}}</span></div>
          <div class="d-flex justify-content-between small mb-2"><span>Taxes & fees</span><span class="js-tax-price">{{pricingDisplay.zero}}</span></div>
          <hr>
          <div class="d-flex justify-content-between fw-bold">
            <span>Total</span>
            <span class="js-total">{{pricingDisplay.basePrice}}</span>
          </div>
        </div>

      </div>
    </div>

    <!-- STEP 3: Check and Pay -->
    <div class="step">
      <div class="d-flex gap-4">

        <!-- Payment form -->
        <div class="payment-container flex-grow-1">
          <h3 class="w-100 px-3 pt-2 mb-3">Your Payment</h3>

          <!-- Saved payment methods -->
          <div class="w-100 px-3 mb-4">
            <h6 class="mb-3">Saved Payment Methods</h6>
            <div class="payment-option-row mb-2">
              <input type="radio" name="payMethod" id="payGoogle" value="google" class="form-check-input me-2">
              <label for="payGoogle" class="d-flex align-items-center gap-2 w-100">
                <img src="/imgs/payments/googlepay-logo.png" alt="Google Pay"
                  style="height:24px;width:auto;object-fit:contain">
                <span class="small">Google Pay ending in 2373</span>
                <span class="badge bg-dark ms-auto" style="font-size:10px">Default</span>
              </label>
            </div>
            <div class="payment-option-row mb-2">
              <input type="radio" name="payMethod" id="payMaster" value="mastercard" class="form-check-input me-2">
              <label for="payMaster" class="d-flex align-items-center gap-2 w-100">
                <img src="/imgs/payments/mastercard-logo.png" alt="Mastercard"
                  style="height:24px;width:auto;object-fit:contain">
                <span class="small">BDO Titanium ending in 4747</span>
              </label>
            </div>
            <div class="payment-option-row">
              <input type="radio" name="payMethod" id="payPaypal" value="paypal" class="form-check-input me-2">
              <label for="payPaypal" class="d-flex align-items-center gap-2 w-100">
                <img src="/imgs/payments/paypal-logo.png" alt="PayPal"
                  style="height:24px;width:auto;object-fit:contain">
                <span class="small">PayPal ending in 4209</span>
              </label>
            </div>
          </div>

          <!-- Order summary -->
          <div class="w-100 px-3">
            <h6 class="mb-3">Order Summary</h6>
            <div class="d-flex justify-content-between small mb-2"><span>Flight: {{flight.origin}} → {{flight.destination}}</span><span class="js-base-fare">{{pricingDisplay.basePrice}}</span></div>
            <div class="d-flex justify-content-between small mb-2"><span class="js-seat-row-label">Seat</span><span class="js-seat-price">{{pricingDisplay.zero}}</span>
            </div>
            <div class="d-flex justify-content-between small mb-2"><span>Meal</span><span class="js-meal-price">{{pricingDisplay.zero}}</span>
            </div>
            <div class="d-flex justify-content-between small mb-2"><span>Baggage (×<span class="js-baggage-count">1</span>)</span><span class="js-baggage-price">{{pricingDisplay.baggagePerUnit}}</span>
            </div>
            <div class="d-flex justify-content-between small mb-2 js-addons-row"><span>Add-ons</span><span class="js-addons-price">{{pricingDisplay.zero}}</span>
            </div>
            <div class="d-flex justify-content-between small mb-2"><span>Taxes & fees</span><span class="js-tax-price">{{pricingDisplay.zero}}</span>
            </div>
            <hr>
            <div class="d-flex justify-content-between fw-bold mb-1"><span>Total</span><span class="js-total">{{pricingDisplay.basePrice}}</span></div>
            <div class="text-muted small">Includes taxes and fees</div>
          </div>

        </div>

        <!-- Booking summary sidebar -->
        <div class="booking-summary-sidebar">
          <h5 class="mb-3">Booking Summary</h5>
          <div class="summary-section mb-3">
            <div class="fw-bold">{{flight.origin}} – {{flight.destination}}</div>
            <div class="text-muted small">{{flight.departureDateFormatted}} · {{flight.departureTimeFormatted}} - {{flight.arrivalTimeFormatted}}</div>
          </div>
          <hr>
          <div class="d-flex justify-content-between small mb-2"><span>Base fare</span><span class="js-base-fare">{{pricingDisplay.basePrice}}</span></div>
          <div class="d-flex justify-content-between small mb-2"><span class="js-seat-row-label">Seat</span><span class="js-seat-price">{{pricingDisplay.zero}}</span>
          </div>
          <div class="d-flex justify-content-between small mb-2"><span>Meal</span><span class="js-meal-price">{{pricingDisplay.zero}}</span></div>
          <div class="d-flex justify-content-between small mb-2"><span>Baggage (×<span class="js-baggage-count">1</span>)</span><span class="js-baggage-price">{{pricingDisplay.baggagePerUnit}}</span>
          </div>
          <div class="d-flex justify-content-between small mb-2 js-addons-row"><span>Add-ons</span><span class="js-addons-price">{{pricingDisplay.zero}}</span>
          </div>
          <div class="d-flex justify-content-between small mb-2"><span>Taxes & fees</span><span class="js-tax-price">{{pricingDisplay.zero}}</span>
          </div>
          <hr>
          <div class="d-flex justify-content-between fw-bold">
            <span>Total</span>
            <span class="js-total">{{pricingDisplay.basePrice}}</span>
          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- Controls -->
  <div class="controls">
    <button type="button" class="back-btn">← Back</button>
    <button type="button" class="next-btn">Next →</button>
    <button type="submit" class="pay-btn">Pay Now</button>
  </div>

  <!-- Pricing config for booking.js to read - see reservationController.showBooking -->
  <script id="pricingConfigData" type="application/json">{{{pricingConfigJSON}}}</script>

</form>
