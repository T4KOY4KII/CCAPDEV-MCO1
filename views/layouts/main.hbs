<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>

    <!--CSS-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    {{#each extraCSS}}
    <link rel="stylesheet" href="{{this}}"><!--Additional CSS for specific designs in pages-->
    {{/each}}

</head>

<body class="d-flex flex-column min-vh-100">

    {{#if isAdmin}}
    {{> navbar-admin}} <!--Renders admin navbar-->
    {{else}}
    {{> navbar-user}} <!--Renders user navbar-->
    {{/if}}

    <main class="flex-grow-1">
        {{{body}}}
    </main>


    {{> footer}}


    <!--Scripts-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="/js/main.js"></script>
    {{#each extraJS}}
    <script src="{{this}}"></script><!--Additional JS for specific scripts in pages-->
    {{/each}}

</body>

</html>